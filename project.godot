; Engine configuration file.
; Solace: a factory game that climbs from the stone age.

config_version=5

[application]

config/name="Solace"
config/description="Guide the Kith from stone tools to super-advanced industry on the planet Solace."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.231373, 0.164706, 0.141176, 1)
